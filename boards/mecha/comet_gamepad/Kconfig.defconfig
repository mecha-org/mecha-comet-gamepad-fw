if BOARD_MECHA_COMET_GAMEPAD

# The MCX C start-up code only disables the COP watchdog when this is set.
# Without it nothing feeds the watchdog and the chip resets.
config WDT_DISABLE_AT_BOOT
	default y

endif # BOARD_MECHA_COMET_GAMEPAD
