config COMET_GAMEPAD_STATUS_LED
	bool "Blink the status LED"
	default y
	depends on $(dt_nodelabel_enabled,status_led)
	help
	  Blink the status LED on the board while the firmware runs. Turn this off in a
	  release build: the case may hide the LED and the LED draws current.
